<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS site làm reverse proxy (cần cài URL Rewrite 2.1 và Application Request Routing 3.0, bật "Enable proxy").
  - /api/* và /media/* → API (Kestrel, chỉ nghe trên 127.0.0.1:5000)
  - mọi đường dẫn khác   → Next.js (node server.js, chỉ nghe trên 127.0.0.1:3000)
  Thư mục site chỉ chứa tệp này. Media nằm ngoài site và được API phục vụ có kiểm tra quyền, IIS không đọc trực tiếp.
  Biến máy chủ HTTP_X_FORWARDED_PROTO phải được cho phép ở cấp máy chủ (xem docs/deploy-iis.md, bước 4).
  Chưa kiểm chứng trên máy chủ Windows thật: kiểm tra lại trên staging trước khi dùng.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- Bật khi đã gắn chứng chỉ TLS cho site (bắt buộc khi vận hành đăng nhập/thi thật). -->
        <rule name="Force HTTPS" stopProcessing="true" enabled="false">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="off" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>

        <rule name="API and media to Kestrel" stopProcessing="true">
          <match url="^(api|media)(/.*)?$" />
          <serverVariables>
            <set name="HTTP_X_FORWARDED_PROTO" value="{MapProto:{HTTPS}}" />
          </serverVariables>
          <action type="Rewrite" url="http://127.0.0.1:5000/{R:0}" />
        </rule>

        <rule name="Everything else to Next.js" stopProcessing="true">
          <match url="(.*)" />
          <serverVariables>
            <set name="HTTP_X_FORWARDED_PROTO" value="{MapProto:{HTTPS}}" />
          </serverVariables>
          <action type="Rewrite" url="http://127.0.0.1:3000/{R:1}" />
        </rule>
      </rules>
      <rewriteMaps>
        <rewriteMap name="MapProto">
          <add key="on" value="https" />
          <add key="off" value="http" />
        </rewriteMap>
      </rewriteMaps>
      <outboundRules>
        <rule name="Remove Server header">
          <match serverVariable="RESPONSE_Server" pattern=".+" />
          <action type="Rewrite" value="" />
        </rule>
      </outboundRules>
    </rewrite>

    <security>
      <requestFiltering removeServerHeader="true">
        <!-- Lớn nhất là tải tệp một lần 100 MB (API cũng giới hạn). Video lớn được tải theo từng phần 5 MB. -->
        <requestLimits maxAllowedContentLength="104857600" />
      </requestFiltering>
    </security>

    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <!-- Bật sau khi HTTPS chạy ổn định:
        <add name="Strict-Transport-Security" value="max-age=31536000" />
        -->
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
